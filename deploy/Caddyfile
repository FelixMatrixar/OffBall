# The VM's one public door (PRD 18.12): TLS from Let's Encrypt for API_HOST, and the routes to the services on the
# internal network. Browsers reach the stream here directly, never through the web app's host.

{$API_HOST} {
	# gzip first: on the live stream at 1x it cuts JSON frames from 1.18 MB a minute to 0.34 MB, under the 0.5 MB
	# budget, where zstd reaches 0.38 MB (PRD open question 15).
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# The API and the live stream. Server-Sent Events go out as they're written.
	handle /api/* {
		reverse_proxy offball:8000 {
			flush_interval -1
		}
	}

	# The public, read-only OffBall MCP endpoint (PRD 14.8).
	handle /mcp* {
		reverse_proxy offball:8001
	}

	# Clips, posters, share cards and speech audio.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# The published datasets (PRD 12.11).
	handle_path /files/* {
		root * /srv/files
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle {
		respond "Not found" 404
	}
}
