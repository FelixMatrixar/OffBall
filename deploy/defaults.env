# Settings every machine shares (PRD 18.14). The machine's own settings and secrets files come after this one in
# compose.yaml, so any of these can be overridden there. No secret ever goes in this file.

# The event bus (PRD 11.5). On the VM the secrets file sets it again, with the password up.sh generated.
VALKEY_URL=valkey://valkey:6379/0

# Traces to the Aspire Dashboard (PRD 18.8).
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire:18889
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# The showcase's moments are found before the first question about them.
OFFBALL_WARM=m07

# Live runs at once (PRD 18.3): the load test sets this for the VM's size.
LIVE_MAX_MATCHES=10
