{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "offball-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 5173
    },
    {
      "name": "offball-api",
      "runtimeExecutable": ".venv/Scripts/offball.exe",
      "runtimeArgs": ["serve", "all"],
      "port": 8000
    },
    {
      "name": "offball-api-stand-in",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "tests.stand_in_server"],
      "port": 8010
    }
  ]
}
