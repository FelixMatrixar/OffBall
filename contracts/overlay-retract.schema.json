    },
    "replacement_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replacement Id"
    },
    "sent_at": {
      "title": "Sent At",
      "type": "string"
    }
