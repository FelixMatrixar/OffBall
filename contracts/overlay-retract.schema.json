{
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "overlay.retract",
      "default": "overlay.retract",
      "title": "Type",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "overlay_id": {
      "title": "Overlay Id",
      "type": "string"
    },
    "reason": {
      "enum": [
        "correction",
        "producer",
        "superseded",
        "expired"
      ],
