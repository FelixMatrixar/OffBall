{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "label",
        "question"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AnswerChart": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "spec": {
          "additionalProperties": true,
          "description": "A Vega-Lite spec without colours; the frontend themes it (VIS-7)",
          "title": "Spec",
          "type": "object"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "title",
        "spec",
        "summary",
        "columns",
        "rows"
      ],
      "title": "AnswerChart",
      "type": "object"
    },
    "AnswerClaim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        },
        "evidence": {
          "description": "Event and frame IDs, or metric names with their values",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "text",
        "verified",
        "evidence"
      ],
      "title": "AnswerClaim",
      "type": "object"
    },
    "AnswerShow": {
      "additionalProperties": false,
      "description": "The play that shows an answer on the pitch: the app jumps there, rings the players and plays it.",
      "properties": {
        "period": {
          "title": "Period",
          "type": "integer"
        },
        "from_ms": {
          "title": "From Ms",
          "type": "integer"
        },
        "to_ms": {
          "title": "To Ms",
          "type": "integer"
        },
        "player_ids": {
          "items": {
            "type": "string"
          },
          "title": "Player Ids",
          "type": "array"
        },
        "moment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Moment Id"
        }
      },
      "required": [
        "period",
        "from_ms",
        "to_ms",
        "player_ids"
      ],
      "title": "AnswerShow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`Answer` in web/src/lib/pundit.ts: Ask OffBall's reply (INTEGRATION.md 6.1).",
  "properties": {
    "question": {
      "title": "Question",
      "type": "string"
    },
    "state": {
      "enum": [
        "ok",
        "partial",
        "declined",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/AnswerClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "chart": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerChart"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tools": {
      "description": "The tools the Pundit called, in order",
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "alternative": {
      "anyOf": [
        {
          "$ref": "#/$defs/Alternative"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "For a declined or unknown question"
    },
    "corrected": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A corrected event changed the answer",
      "title": "Corrected"
    },
    "show": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerShow"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The play that shows the answer on the pitch"
    }
  },
  "required": [
    "question",
    "state",
    "claims",
    "tools"
  ],
  "title": "Answer",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offball.dev/contracts/answer.schema.json"
}
