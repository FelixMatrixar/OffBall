{
  "additionalProperties": false,
  "description": "A typed alert from a Fabric Activator rule, published to the `alerts` hub (PRD 17.4) for the Engineer and the\nproducer console.",
  "properties": {
    "schema_version": {
      "default": "2.0",
      "description": "Contract version, e.g. 2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "alert",
      "default": "alert",
      "title": "Kind",
      "type": "string"
    },
    "alert_id": {
      "title": "Alert Id",
      "type": "string"
    },
    "match_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Match Id"
    },
    "rule": {
      "enum": [
        "fatigue_gap",
        "momentum_swing",
        "latency_trend",
        "other"
      ],
      "title": "Rule",
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "description": "What the rule saw, as Activator passed it",
      "title": "Properties"
    },
    "raised_at": {
      "description": "ISO 8601 UTC timestamp",
      "title": "Raised At",
      "type": "string"
    },
    "source": {
      "default": "activator",
      "enum": [
        "activator",
        "power-automate",
        "engineer"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "alert_id",
    "rule",
    "severity",
    "summary",
    "raised_at"
  ],
  "title": "Alert",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offball.dev/contracts/alert.schema.json"
}
