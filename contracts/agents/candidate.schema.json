{
  "$defs": {
    "Signal": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Metric name, e.g. defender_displacement_m",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "value",
        "threshold",
        "unit"
      ],
      "title": "Signal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A candidate moment from the interpret service: its type, participants and signal strengths.",
  "properties": {
    "schema_version": {
      "default": "2.0",
      "description": "Contract version, e.g. 2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "candidate",
      "default": "candidate",
      "title": "Kind",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "period": {
      "title": "Period",
      "type": "integer"
    },
    "t_start_ms": {
      "title": "T Start Ms",
      "type": "integer"
    },
    "t_end_ms": {
      "title": "T End Ms",
      "type": "integer"
    },
    "type": {
      "enum": [
        "decoy_run",
        "overlap",
        "underlap",
        "third_man_run",
        "blind_side_run",
        "timed_run_in_behind",
        "false_9_drop",
        "pinning",
        "rotation",
        "set_piece_screen",
        "switch_of_play",
        "press_broken",
        "fatigue_gap",
        "space_lost",
        "rest_defence_exposed",
        "cover_shadow"
      ],
      "title": "Type",
      "type": "string"
    },
    "team_id": {
      "title": "Team Id",
      "type": "string"
    },
    "creator_id": {
      "title": "Creator Id",
      "type": "string"
    },
    "dragged_ids": {
      "items": {
        "type": "string"
      },
      "title": "Dragged Ids",
      "type": "array"
    },
    "receiver_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Receiver Id"
    },
    "gap_zone": {
      "items": {
        "description": "Pitch position in metres: [x, y]",
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Gap Zone",
      "type": "array"
    },
    "run_from": {
      "anyOf": [
        {
          "description": "Pitch position in metres: [x, y]",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run From"
    },
    "run_to": {
      "anyOf": [
        {
          "description": "Pitch position in metres: [x, y]",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run To"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/Signal"
      },
      "title": "Signals",
      "type": "array"
    },
    "strength": {
      "description": "Mean signal ratio, capped; 1.0 means every threshold is met",
      "title": "Strength",
      "type": "number"
    },
    "status": {
      "default": "confirmed",
      "enum": [
        "speculative",
        "confirmed",
        "discarded"
      ],
      "title": "Status",
      "type": "string"
    },
    "space_created_m2": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Space Created M2"
    },
    "epv_gain": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Epv Gain"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "match_id",
    "period",
    "t_start_ms",
    "t_end_ms",
    "type",
    "team_id",
    "creator_id",
    "strength"
  ],
  "title": "Candidate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offball.dev/contracts/agents/candidate.schema.json"
}
