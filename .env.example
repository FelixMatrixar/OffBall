# Local development settings. Copy this file to .env, which git ignores, and fill it in.
# Azure deployments don't read this file: they sign in with managed identity (PRD 18.11).

# Your Foundry resource's endpoint, from the Foundry portal (the resource's Overview page).
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# The resource's key, from the same page. Leave it empty to sign in with your Azure account instead.
AZURE_OPENAI_API_KEY=
# Optional: an API version, if your deployment needs a specific one.
AZURE_OPENAI_API_VERSION=

# Model deployment names, one per tier (PRD 14.13).
OFFBALL_MODEL_FAST=gpt-5-mini
OFFBALL_MODEL_REASONING=gpt-5

# Optional: have the agents call their tools through the OffBall MCP server (offball serve mcp)
# instead of in the same process.
# OFFBALL_MCP_URL=http://localhost:8001/mcp
