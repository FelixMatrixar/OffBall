# Local development settings. Copy this file to .env, which git ignores, and fill it in.
# The VM doesn't read this file: its settings and secrets live in /etc/offball/ (PRD 18.14).

# The agents' models come from OpenRouter (PRD 14.13). Your OpenRouter key, from openrouter.ai/keys.
OPENROUTER_API_KEY=
# Optional: another OpenAI-compatible endpoint in OpenRouter's place.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Or, with no OpenRouter key, a model deployed in a Foundry resource: its endpoint, from the Foundry portal
# (the resource's Overview page), and its key, or leave the key empty to sign in with your Azure account.
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=

# Model names, one per tier (PRD 14.13): OpenRouter model IDs, or Foundry deployment names.
OFFBALL_MODEL_FAST=openai/gpt-6-luna
OFFBALL_MODEL_REASONING=openai/gpt-6-luna
# How hard each tier thinks on OpenRouter: minimal, low, medium or high.
OFFBALL_EFFORT_FAST=low
OFFBALL_EFFORT_REASONING=high
# The most output tokens one call may produce, thinking included. OpenRouter holds back credit for this many.
OFFBALL_MAX_TOKENS_FAST=4000
OFFBALL_MAX_TOKENS_REASONING=16000

# Optional: have the agents call their tools through the OffBall MCP server (offball serve mcp)
# instead of in the same process.
# OFFBALL_MCP_URL=http://localhost:8001/mcp

# Optional: send each live run's feed through the Valkey event bus (PRD 11.5). `docker compose up` sets it for you.
# VALKEY_URL=valkey://localhost:6379/0

# Optional: send traces to the Aspire Dashboard (PRD 18.8), or print them with OFFBALL_TRACE=console.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
