{
  "name": "offball-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "playwright test --project=unit --project=e2e --project=visual",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:perf": "playwright test --project=perf --workers=1",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run typecheck && npm run lint:tokens && npm test",
    "clips": "npm run build && node scripts/render-clips.mjs",
    "feed:export": "node scripts/export-feed.mjs",
    "feed:serve": "node scripts/feed-server.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uqr": "0.1.3",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.21",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "ajv": "8.17.1",
    "axe-core": "4.13.0",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
